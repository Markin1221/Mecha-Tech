{
  "schemaVersion": 1,
  "id": "mechatech",
  "version": "${version}",
  "name": "Mecha-Tech",
  "description": "Mechas modulares e customizáveis: ferramentas, exo-armaduras e mechas pilotáveis montados peça por peça.",
  "authors": ["markin1221"],
  "contact": {
    "homepage": "https://github.com/markin1221/Mecha-Tech",
    "sources": "https://github.com/markin1221/Mecha-Tech"
  },
  "license": "CC0-1.0",
  "icon": "assets/mechatech/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": ["com.markin.mechatech.MechaTech"],
    "client": ["com.markin.mechatech.client.MechaTechClient"]
  },
  "mixins": [
    "mechatech.mixins.json",
    {
      "config": "mechatech.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.19.3",
    "minecraft": "~26.1.2",
    "java": ">=25",
    "fabric-api": "*"
  }
}
